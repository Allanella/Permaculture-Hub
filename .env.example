# Permaculture Hub Northern Uganda Website
# Environment variables configuration example
# Copy this file to .env.local and fill in actual values for local development

# No environment variables are currently required for the basic website.
# If you add email forms, analytics, or other integrations, add them here.

# Example: Email Service (if you add form submission)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Example: Analytics (if you add tracking)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Example: Contact Form (if you add backend processing)
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact
